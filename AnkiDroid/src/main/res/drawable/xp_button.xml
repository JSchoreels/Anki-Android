<!-- kuma3 XP theme: a Windows XP push button (white-to-beige gradient, dark blue rounded border) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
<item android:id="@+id/shape_background" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
    <selector>
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient android:angle="270" android:startColor="#CDCAC3" android:centerColor="#E3E3DB" android:endColor="#F2F2F1" />
                <stroke android:width="1dp" android:color="@color/xp_button_border" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient android:angle="270" android:startColor="#FFFFFF" android:centerColor="#ECEBE6" android:endColor="#D6D0C5" />
                <stroke android:width="1dp" android:color="@color/xp_button_border" />
            </shape>
        </item>
    </selector>
</item>
</layer-list>
