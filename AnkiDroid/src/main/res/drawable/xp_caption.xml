<!-- kuma3 XP theme: a title bar caption button (blue rounded square, light top left, white edge) behind toolbar
     actions; a fixed 32dp square, so wider actions (sync with its badge) get the same size as the others -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="32dp" android:height="32dp" android:gravity="center">
        <selector>
            <item android:state_pressed="true">
                <shape><corners android:radius="3dp" />
                    <gradient android:angle="315" android:startColor="#3C6FD8" android:centerColor="#1747B8" android:endColor="#0A3399" />
                    <stroke android:width="1dp" android:color="#FFFFFF" /></shape>
            </item>
            <item>
                <shape><corners android:radius="3dp" />
                    <gradient android:angle="315" android:startColor="#6F93E6" android:centerColor="#2A62DD" android:endColor="#0047D6" />
                    <stroke android:width="1dp" android:color="#FFFFFF" /></shape>
            </item>
        </selector>
    </item>
</layer-list>
