<!-- kuma3 XP theme: a title bar caption button (blue rounded square, light top left, white edge) behind toolbar actions -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="8dp">
    <selector>
        <item android:state_pressed="true">
            <shape><corners android:radius="3dp" />
                <gradient android:angle="315" android:startColor="#4479E4" android:centerColor="#1A4FC9" android:endColor="#003BB0" />
                <stroke android:width="1dp" android:color="#FFFFFF" /></shape>
        </item>
        <item>
            <shape><corners android:radius="3dp" />
                <gradient android:angle="315" android:startColor="#A3BBEC" android:centerColor="#3A70E0" android:endColor="#0054E9" />
                <stroke android:width="1dp" android:color="#FFFFFF" /></shape>
        </item>
    </selector>
</inset>
