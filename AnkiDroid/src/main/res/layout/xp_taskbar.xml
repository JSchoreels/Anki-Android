<!-- kuma3 XP theme: the taskbar on the deck list (Start opens the side menu, the tray shows the clock) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xp_taskbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/xp_taskbar"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/xp_start"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/xp_start"
        android:drawableStart="@drawable/xp_flag"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="20dp"
        android:shadowColor="#222222"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="2"
        android:text="start"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/xp_task"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="kuma3"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/xp_tray"
        android:format12Hour="h:mm a"
        android:format24Hour="H:mm"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
