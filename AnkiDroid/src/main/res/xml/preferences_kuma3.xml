<!-- Settings > kuma3: read by com.ichi2.anki.kuma3.Kuma3Settings (keys must match) -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="kuma3"
    android:key="@string/kuma3_screen_key">
    <PreferenceCategory android:title="@string/kuma3_pref_deck_list">
        <SwitchPreferenceCompat
            android:key="@string/kuma3_heatmap_key"
            android:title="@string/kuma3_pref_heatmap"
            android:summary="@string/kuma3_pref_heatmap_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="@string/kuma3_deck_times_key"
            android:title="@string/kuma3_pref_deck_times"
            android:summary="@string/kuma3_pref_deck_times_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="@string/kuma3_leaderboard_key"
            android:title="@string/kuma3_leaderboard" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Lofi">
        <SwitchPreferenceCompat
            android:key="@string/kuma3_lofi_key"
            android:title="@string/kuma3_pref_lofi"
            android:summary="@string/kuma3_pref_lofi_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="RWKV">
        <SwitchPreferenceCompat
            android:key="@string/kuma3_rwkv_forecast_key"
            android:title="@string/kuma3_pref_rwkv_forecast"
            android:summary="@string/kuma3_pref_rwkv_forecast_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="@string/kuma3_rwkv_forecast_graph_key"
            android:dependency="@string/kuma3_rwkv_forecast_key"
            android:title="@string/kuma3_pref_rwkv_forecast_graph"
            android:summary="@string/kuma3_pref_rwkv_forecast_graph_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="@string/kuma3_rwkv_toast_key"
            android:title="@string/kuma3_pref_rwkv_toast"
            android:summary="@string/kuma3_pref_rwkv_toast_summary"
            android:defaultValue="true" />
        <ListPreference
            android:key="@string/kuma3_rwkv_model_key"
            android:title="@string/kuma3_pref_rwkv_model"
            android:entries="@array/kuma3_rwkv_model_labels"
            android:entryValues="@array/kuma3_rwkv_model_values"
            android:defaultValue="big"
            android:summary="@string/kuma3_pref_rwkv_model_summary" />
        <ListPreference
            android:key="@string/kuma3_rwkv_precision_key"
            android:title="@string/kuma3_pref_rwkv_precision"
            android:entries="@array/kuma3_rwkv_precision_labels"
            android:entryValues="@array/kuma3_rwkv_precision_values"
            android:defaultValue="int8"
            android:summary="@string/kuma3_pref_rwkv_precision_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/kuma3_pref_reviewer">
        <SwitchPreferenceCompat
            android:key="@string/kuma3_answer_fade_key"
            android:title="@string/kuma3_pref_answer_fade"
            android:summary="@string/kuma3_pref_answer_fade_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/kuma3_pref_updates">
        <SwitchPreferenceCompat
            android:key="@string/kuma3_update_check_key"
            android:title="@string/kuma3_pref_update_check"
            android:summary="@string/kuma3_pref_update_check_summary"
            android:defaultValue="true" />
        <Preference
            android:key="@string/kuma3_update_now_key"
            android:title="@string/kuma3_pref_update_now" />
    </PreferenceCategory>
</PreferenceScreen>
